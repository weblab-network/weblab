# Build from the exact upstream release used by the stock Weblab profile.
# Context is generated by tools/build_frr_lldp.py, never the workspace root.
FROM quay.io/frrouting/frr@sha256:e995beaa50fdc9edb35eadcfefa29b7f062cc06f2b812613789b68fa541554d2 AS build
RUN apk add --no-cache autoconf automake libtool build-base bison flex \
    python3-dev py3-pytest json-c-dev c-ares-dev readline-dev libcap-dev \
    elfutils-dev protobuf-c-dev protobuf-c-compiler rtrlib-dev lua5.3-dev patch
WORKDIR /src/frr
ADD frr-source.tar /src/frr/
COPY lldp-vtysh.patch /tmp/lldp-vtysh.patch
RUN patch --batch --fuzz=0 -p1 < /tmp/lldp-vtysh.patch
RUN ./bootstrap.sh && CFLAGS='-O2 -g0' CXXFLAGS='-O2 -g0' ./configure \
    --prefix=/usr --sysconfdir=/etc --localstatedir=/var --sbindir=/usr/lib/frr \
    --libdir=/usr/lib --enable-rpki --enable-vtysh --enable-multipath=64 \
    --enable-vty-group=frrvty --enable-user=frr --enable-group=frr \
    --enable-pcre2posix --enable-scripting --disable-doc \
    --with-pkg-extra-version=_weblab_lldp_snmp_vlan_vrrp1
ARG JOBS=2
RUN make -j${JOBS} && make DESTDIR=/out install

FROM quay.io/frrouting/frr@sha256:e995beaa50fdc9edb35eadcfefa29b7f062cc06f2b812613789b68fa541554d2
RUN apk add --no-cache lldpd=1.0.19-r0 net-snmp=5.9.4-r1 net-snmp-tools=5.9.4-r1
COPY --from=build /out/usr/ /usr/
COPY lldp_backend.py /usr/lib/frr/weblab_lldp.py
COPY snmp_backend.py /usr/lib/frr/snmp_backend.py
COPY vlan_backend.py /usr/lib/frr/vlan_backend.py
COPY vrrp_backend.py /usr/lib/frr/vrrp_backend.py
COPY docker-start /usr/lib/frr/docker-start
COPY frr-source.tar lldp-vtysh.patch NOTICE SOURCES.md Weblab-LICENSE Dockerfile collect_sources.py lldp_backend.py snmp_backend.py vlan_backend.py vrrp_backend.py docker-start /usr/share/weblab-frr/
RUN python3 -c "import sys,json; sys.path.insert(0,'/usr/share/weblab-frr'); from collect_sources import inventory; from pathlib import Path; Path('/usr/share/weblab-frr/packages.json').write_text(json.dumps(inventory(Path('/lib/apk/db/installed').read_text()),indent=2)+'\n')"
RUN chmod 755 /usr/lib/frr/docker-start
LABEL network.weblab.frr.extension="lldp-1" \
    network.weblab.frr.snmp="v2c-1" \
    network.weblab.frr.vlan="8021q-1" \
    network.weblab.frr.vrrp="ipv4-1" \
    org.opencontainers.image.version="10.7.1-wl1" \
    org.opencontainers.image.title="Weblab FRR" \
    org.opencontainers.image.source="https://github.com/weblab-network/weblab" \
    org.opencontainers.image.url="https://github.com/weblab-network/weblab/releases/tag/v0.8.0" \
    org.opencontainers.image.description="FRR 10.7.1 with Weblab native LLDP, SNMPv2c, routed VLAN and IPv4 VRRP CLI integration"
