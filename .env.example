# Paths are on the Docker host. Relative paths are beside compose.yaml.
WL_IMAGES_DIR=./images
WL_DATA_DIR=./lab-data
WL_HOSTNAME=weblab
WL_PORT=8080
# Set a trusted LAN address (or 0.0.0.0) only when remote access is wanted.
WL_BIND=127.0.0.1

# Used only by compose.prebuilt.yaml; pin a version tag for reproducible upgrades.
WL_IMAGE=ghcr.io/weblab-network/weblab:latest

# Optional compose.agent.prebuilt.yaml; pin the same version as WL_IMAGE.
WL_AGENT_IMAGE=ghcr.io/weblab-network/weblab-agent:latest
# Used by either Agent override for Ollama; OpenAI sign-in does not need Ollama.
WL_AGENT_PROVIDERS=http://127.0.0.1:11434/v1

# Explicit opt-in for modified images under the supported FRR tag.
WL_ALLOW_UNTESTED_FRR=0

# Optional trusted-local MCP topology automation (off by default).
WL_AUTOMATION=0
