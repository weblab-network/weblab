# Paths are on the Docker host. Relative paths are beside compose.yaml.
WL_IMAGES_DIR=./images
WL_DATA_DIR=./lab-data
WL_HOSTNAME=weblab
WL_PORT=8080
# Set a trusted LAN address (or 0.0.0.0) only when remote access is wanted.
WL_BIND=127.0.0.1

# Used only by compose.prebuilt.yaml; pin a version tag for reproducible upgrades.
WL_IMAGE=ghcr.io/weblab-network/weblab:latest

# Optional compose.agent.prebuilt.yaml; pin the same version as WL_IMAGE.
WL_AGENT_IMAGE=ghcr.io/weblab-network/weblab-agent:latest
# Used by either Agent override for Ollama; OpenAI sign-in does not need Ollama.
WL_AGENT_PROVIDERS=http://127.0.0.1:11434/v1

# Explicit opt-in for modified images under the supported FRR tag.
WL_ALLOW_UNTESTED_FRR=0

# Optional trusted-local MCP topology automation (off by default).
WL_AUTOMATION=0

# Optional fixed-account authentication (see docs/authentication.md).
# Generate unique passwords locally with: python3 web_auth.py generate
# With WL_AUTH=1, optional Agent is admin-only; external MCP stays disabled.
WL_AUTH=0
WL_AUTH_ADMIN_PASSWORD=
WL_AUTH_USER_PASSWORD=
WL_AUTH_GUEST_PASSWORD=
# Set 1 behind HTTPS; leave 0 only for localhost/SSH or trusted HTTP testing.
WL_AUTH_COOKIE_SECURE=0

# To unlock one account, change its reset value and recreate the lab service.
# Keep the value afterwards; each change (including removal) resets that account.
# Admin passwords: 16–256 characters. New/changed user and guest passwords:
# 6–256 characters, including an ASCII letter and a digit. Use distinct passwords.
WL_AUTH_ADMIN_RESET=
WL_AUTH_USER_RESET=
WL_AUTH_GUEST_RESET=
